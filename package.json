{
  "private": true,
  "name": "feature-toggles",
  "author": "Nicola Bello <nicola.bello.3@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/nicolabello/feature-toggles"
  },
  "license": "GPL-2.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@feature-toggles/express --filter=@feature-toggles/helpers",
    "dev:angular": "turbo run dev --filter=@feature-toggles/angular --filter=@feature-toggles/express --filter=@feature-toggles/helpers",
    "dev:react": "turbo run dev --filter=@feature-toggles/react --filter=@feature-toggles/express --filter=@feature-toggles/helpers",
    "dev:vue": "turbo run dev --filter=@feature-toggles/vue --filter=@feature-toggles/express --filter=@feature-toggles/helpers",
    "dev:svelte": "turbo run dev --filter=@feature-toggles/svelte --filter=@feature-toggles/express --filter=@feature-toggles/helpers",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "angular-eslint": "^22.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-svelte": "^3.23.1",
    "eslint-plugin-vue": "^10.11.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "turbo": "^2.11.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
